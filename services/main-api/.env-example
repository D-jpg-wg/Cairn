# Шаблон окружения сервиса main-api. Скопируй в .env и подставь значения.
# .env коммитить НЕЛЬЗЯ, .env-example — нужно.

APP_NAME=cairn-main-api

# Подключение к БД (своя БД сервиса — database-per-service).
# DB_HOST=localhost  — когда app/alembic запущены локально через `uv run`
#                      (Postgres в docker, порт проброшен наружу; см. DB_PORT).
# DB_HOST=main-db    — когда сам сервис крутится внутри docker-compose.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cairn_main
DB_USER=cairn
DB_PASSWORD=cairn

# main-api только ПРОВЕРЯЕТ JWT — нужен лишь публичный ключ auth-сервиса.
# Приватного ключа здесь быть не должно.
# Локально: положить копию keys/jwt_public.pem (каталог keys/ в .gitignore).
# В docker: монтируется через secret, путь переопределяется:
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
