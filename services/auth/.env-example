# Шаблон окружения сервиса auth. Скопируй в .env и подставь значения.
# .env коммитить НЕЛЬЗЯ, .env-example — нужно.

APP_NAME=cairn-auth

# Окружение: dev | prod. В prod cookie выставляется с флагом Secure (только https).
ENVIRONMENT=dev

# Куда редиректить пользователя после успешного входа (фронт main-app).
APP_URL=http://localhost:8001/

# Подключение к БД.
# DB_HOST=localhost  — когда app/alembic запущены локально через `uv run`
#                      (Postgres в docker, порт проброшен наружу).
# DB_HOST=auth-db    — когда сам сервис крутится внутри docker-compose
#                      (контейнеры видят друг друга по имени сервиса).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cairn_auth
DB_USER=cairn
DB_PASSWORD=cairn

# JWT подписывается RS256: приватным ключом подписываем, публичным проверяем.
# Сгенерировать пару (в каталоге сервиса):
#   openssl genpkey -algorithm RSA -out keys/jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt_private.pem -out keys/jwt_public.pem
# Каталог keys/ в .gitignore — ключи не коммитим. Пути можно переопределить:
# JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# OAuth 2.0 (Google). Получить в Google Cloud Console → Credentials → OAuth client ID.
# GOOGLE_REDIRECT_URL должен совпадать с Authorized redirect URI в консоли символ в символ.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/google/callback

# Секрет подписи cookie-сессии (хранит OAuth state). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
