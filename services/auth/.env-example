# Шаблон окружения сервиса auth. Скопируй в .env и подставь значения.
# .env коммитить НЕЛЬЗЯ, .env-example — нужно.

APP_NAME=cairn-auth

# Подключение к БД.
# DB_HOST=localhost  — когда app/alembic запущены локально через `uv run`
#                      (Postgres в docker, порт проброшен наружу).
# DB_HOST=auth-db    — когда сам сервис крутится внутри docker-compose
#                      (контейнеры видят друг друга по имени сервиса).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cairn_auth
DB_USER=auth_admin
DB_PASSWORD=auth_admin123

SECRET_KEY=some_secret_key
